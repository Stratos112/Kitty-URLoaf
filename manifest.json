{
  "manifest_version": 2,
  "name": "Kitty URLoaf",
  "version": "0.1.0",
  "description": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "urloaf@kitty",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "static/icons/icon-16.png",
    "48": "static/icons/icon-48.png",
    "128": "static/icons/icon-128.png"
  },
  "browser_action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "static/icons/icon-16.png",
      "48": "static/icons/icon-48.png",
      "128": "static/icons/icon-128.png"
    }
  },
  "sidebar_action": {
    "default_panel": "src/sidepanel/sidepanel.html",
    "default_icon": {
      "16": "static/icons/icon-16.png",
      "48": "static/icons/icon-48.png",
      "128": "static/icons/icon-128.png"
    },
    "default_title": "Pants"
  },
  "background": {
    "scripts": ["src/background/background.js"]
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["src/content/tracker.js"],
    "run_at": "document_start"
  }],
  "permissions": ["storage"]
}
